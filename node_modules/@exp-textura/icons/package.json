{
  "name": "@exp-textura/icons",
  "version": "0.7.0",
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/nintex/_packaging/Nintex/npm/registry/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./brand": {
      "import": {
        "types": "./dist/brand/index.d.ts",
        "default": "./dist/brand/index.js"
      },
      "require": {
        "types": "./dist/brand/index.d.cts",
        "default": "./dist/brand/index.cjs"
      }
    },
    "./streamline-sl": {
      "import": {
        "types": "./dist/streamline-sl/index.d.ts",
        "default": "./dist/streamline-sl/index.js"
      },
      "require": {
        "types": "./dist/streamline-sl/index.d.cts",
        "default": "./dist/streamline-sl/index.cjs"
      }
    },
    "./streamline-ss": {
      "import": {
        "types": "./dist/streamline-ss/index.d.ts",
        "default": "./dist/streamline-ss/index.js"
      },
      "require": {
        "types": "./dist/streamline-ss/index.d.cts",
        "default": "./dist/streamline-ss/index.cjs"
      }
    },
    "./streamline-remix": {
      "import": {
        "types": "./dist/streamline-remix/index.d.ts",
        "default": "./dist/streamline-remix/index.js"
      },
      "require": {
        "types": "./dist/streamline-remix/index.d.cts",
        "default": "./dist/streamline-remix/index.cjs"
      }
    },
    "./streamline-sg": {
      "import": {
        "types": "./dist/streamline-sg/index.d.ts",
        "default": "./dist/streamline-sg/index.js"
      },
      "require": {
        "types": "./dist/streamline-sg/index.d.cts",
        "default": "./dist/streamline-sg/index.cjs"
      }
    },
    "./homebrew": {
      "import": {
        "types": "./dist/homebrew/index.d.ts",
        "default": "./dist/homebrew/index.js"
      },
      "require": {
        "types": "./dist/homebrew/index.d.cts",
        "default": "./dist/homebrew/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "glob": "^11.1.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "xmldom": "^0.6.0"
  },
  "scripts": {
    "dev": "pnpm run build",
    "build": "pnpm run build:svgs && pnpm run build:lib && vite build",
    "build:svgs": "node ./scripts/build-svg-attrs.js",
    "build:lib": "pnpm run transform:brand && pnpm run transform:streamline-sl && pnpm run transform:streamline-ss && pnpm run transform:streamline-remix && pnpm run transform:streamline-sg && pnpm run transform:homebrew && node ./scripts/build-lib.js",
    "transform:brand": "pnpm svgr --out-dir src/brand --ignore-existing collections/brand --jsx-runtime automatic --typescript",
    "transform:streamline-sl": "pnpm svgr --out-dir src/streamline-sl --ignore-existing collections/streamline-sl --jsx-runtime automatic --typescript",
    "transform:streamline-ss": "pnpm svgr --out-dir src/streamline-ss --ignore-existing collections/streamline-ss --jsx-runtime automatic --typescript",
    "transform:streamline-remix": "pnpm svgr --out-dir src/streamline-remix --ignore-existing collections/streamline-remix --jsx-runtime automatic --typescript",
    "transform:streamline-sg": "pnpm svgr --out-dir src/streamline-sg --ignore-existing collections/streamline-sg --jsx-runtime automatic --typescript",
    "transform:homebrew": "pnpm svgr --out-dir src/homebrew --ignore-existing collections/homebrew --jsx-runtime automatic --typescript"
  }
}