{
  "name": "@exp-textura/react",
  "version": "0.9.0",
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/nintex/_packaging/Nintex/npm/registry/"
  },
  "type": "module",
  "author": "Tyler Drake <tyler.drake@nintex.com>",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./bundled-themes": {
      "import": {
        "types": "./dist/theme/bundled-themes/index.d.ts",
        "default": "./dist/theme/bundled-themes/index.js"
      },
      "require": {
        "types": "./dist/theme/bundled-themes/index.d.ts",
        "default": "./dist/theme/bundled-themes/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme.d.ts",
        "default": "./dist/theme/index.js"
      },
      "require": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.cjs"
      }
    },
    "./fonts.css": "./dist/theme/fonts/fonts.css",
    "./*": {
      "import": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.js"
      },
      "require": {
        "types": "./dist/components/*/index.d.ts",
        "default": "./dist/components/*/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@platejs/basic-nodes": "^52.0.11",
    "@platejs/floating": "^52.0.11",
    "@platejs/link": "^52.3.10",
    "@platejs/list-classic": "^52.3.10",
    "platejs": "^52.0.17",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@exp-textura/icons": "0.7.0"
  },
  "peerDependenciesMeta": {
    "@platejs/basic-nodes": {
      "optional": true
    },
    "@platejs/floating": {
      "optional": true
    },
    "@platejs/link": {
      "optional": true
    },
    "@platejs/list-classic": {
      "optional": true
    },
    "platejs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/react": "^3.1.1",
    "@platejs/basic-nodes": "^52.3.10",
    "@platejs/basic-styles": "^52.3.10",
    "@platejs/code-block": "^52.3.16",
    "@platejs/floating": "^52.3.10",
    "@platejs/indent": "^52.3.10",
    "@platejs/link": "^52.3.17",
    "@platejs/list-classic": "^52.3.10",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-links": "^10.3.6",
    "@storybook/cli": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.3",
    "@types/inputmask": "^5.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/recharts": "^2.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-playwright": "^2.2.2",
    "dotenv": "^17.4.2",
    "happy-dom": "^16.8.1",
    "http-server": "^14.1.1",
    "monaco-editor": "^0.53.0",
    "platejs": "^52.3.21",
    "playwright": "^1.59.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.6",
    "storybook-addon-tag-badges": "^3.1.0",
    "vite": "^6.4.2",
    "vite-plugin-dts": "^4.5.4",
    "wait-on": "^8.0.5",
    "@exp-textura/icons": "0.7.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
