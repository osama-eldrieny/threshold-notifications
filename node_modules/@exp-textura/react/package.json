    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toolbar": "^1.1.11",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "focus-trap-react": "^11.0.6",
    "inputmask": "^5.0.9",
    "lodash-es": "^4.18.1",
    "re-resizable": "^6.11.2",
    "react-hook-form": "^7.74.0",
    "react-is": "^19.2.5",
    "react-remove-scroll": "^2.7.2",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "~3.7.0",
    "@exp-textura/icons": "0.7.0"
  },
  "scripts": {
    "prebuild": "tsx ./scripts/prebuild.ts",
    "build": "tsc && vite build",
    "build-storybook": "pnpm storybook build",
    "dev": "pnpm prebuild && tsc && vite build --minify false && tsx scripts/start-storybook.ts",
    "lint": "eslint .",
    "lint:ts": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "pnpm exec playwright install && pnpm storybook build && pnpm concurrently -k -s first -n \"'SB,TEST; -c 'magenta,blue'\" \"pnpm http-server storybook-static --port 6015 --silent\" \"pnpm wait-on tcp:127.0.0.1:6015 && pnpm test-storybook --url http://127.0.0.1:6015\""
  }
}